#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp N1     &kp N2     &kp N3  &kp N4  &kp N5  &kp N6  &none                                                                             &kp C_MUTE       &kp N7  &kp N8          &kp N9           &kp N0    &kp EQUAL      &kp MINUS
&kp TAB    &kp Q      &kp W   &kp E   &kp R   &kp T   &none                                                                             &kp C_VOLUME_UP  &kp Y   &kp U           &kp I            &kp O     &kp P          &kp BACKSLASH
&kp ESC    &kp A      &kp S   &kp D   &kp F   &kp G   &none      &mo 1           &kp LEFT_ALT          &kp LGUI      &kp RIGHT_CONTROL  &kp C_VOL_DN     &kp H   &kp J           &kp K            &kp L     &kp SEMICOLON  &kp SQT
&kp LSHFT  &kp Z      &kp X   &kp C   &kp V   &kp B                              &kp LEFT_CONTROL      &kp DELETE                                        &kp N   &kp M           &kp M            &kp DOT   &kp FSLH       &kp RSHFT
&mo 1      &kp GRAVE  &none   &none   &none           &kp SPACE  &kp LEFT_SHIFT  &kp PRINTSCREEN       &kp CAPSLOCK  &kp ENTER          &kp BACKSPACE            &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LBKT  &kp RBKT       &mo 1
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1     &kp F2            &kp F3             &kp F4            &kp F5          &kp F6     &none                                       &none   &kp F7            &kp F8             &kp F9          &kp F10          &kp F11  &kp F12
&kp GRAVE  &kp LESS_THAN     &kp GREATER_THAN   &kp SINGLE_QUOTE  &kp UNDERSCORE  &kp SLASH  &none                                       &none   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans   &trans
&trans     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp EXCLAMATION   &kp QUESTION    &kp PLUS   &none   &trans  &trans      &trans  &trans  &none   &kp LEFT          &kp DOWN           &kp UP          &kp RIGHT        &none    &trans
&trans     &trans            &trans             &trans            &trans          &trans                     &trans      &trans                  &trans            &trans             &trans          &trans           &trans   &trans
&trans     &trans            &trans             &trans            &trans                     &trans  &trans  &trans      &trans  &trans  &trans                    &trans             &trans          &trans           &trans   &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
