#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define UTIL 3
#define LOCAL 4

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        nav_sym_util {
            if-layers = <NAV SYM>;
            then-layer = <UTIL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp N1     &kp N2     &kp N3     &kp N4     &kp N5     &kp N6     &none                                                                                 &mo UTIL      &kp N7     &kp N8     &kp N9       &kp N0     &kp EQUAL      &kp MINUS
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T      &mo UTIL                                                                              &kp CAPS      &kp Y      &kp U      &kp I        &kp O      &kp P          &kp BACKSLASH
&kp ESC    &kp A      &kp S      &kp D      &kp F      &kp G      &none      &kp LCTRL     &kp LALT          &kp LGUI     &kp DELETE      &none         &kp H      &kp J      &kp K        &kp L      &kp SEMICOLON  &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B                                  &mo NAV        &mo SYM                                                &kp N      &kp M      &kp COMMA    &kp DOT    &kp FSLH       &kp RSHFT
&mo UTIL   &kp GRAVE  &kp LBKT   &kp RBKT   &kp BSLH               &kp SPACE   &kp LSHFT     &kp RALT         &kp RALT     &kp ENTER       &kp BACKSPACE               &kp LBRC   &kp RBRC   &kp LEFT     &kp RIGHT  &mo LOCAL
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans     &none                                                                                 &none         &trans     &trans     &trans       &trans     &trans         &trans
&trans     &trans     &trans     &trans     &trans     &trans     &none                                                                                 &none         &kp INS    &kp HOME   &kp PG_DN    &kp PG_UP   &kp END       &trans
&trans     &trans     &trans     &trans     &trans     &trans     &none      &trans        &trans           &trans       &trans          &none         &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT  &kp ESC       &trans
&trans     &trans     &trans     &trans     &trans     &trans                                 &trans         &trans                                                 &kp LC(LEFT) &kp LC(RIGHT) &kp BACKSPACE &kp DELETE &kp ENTER      &trans
&trans     &trans     &trans     &trans     &trans                 &trans      &trans        &trans           &trans       &trans          &trans                    &trans     &trans     &trans       &trans     &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
&pipe_forward &fat_arrow &thin_arrow &scope_res &null_cond &null_coalesce &none                                                                            &none         &trans     &trans     &trans       &trans     &trans         &trans
&trans     &kp EXCL   &kp AT     &kp HASH   &kp DOLLAR &kp PERCENT &none                                                                               &none         &kp CARET  &kp AMPS   &kp STAR     &kp PIPE   &kp TILDE     &trans
&trans     &kp LPAR   &kp LBRC   &kp LBKT   &kp LT     &kp UNDER   &none      &trans        &trans           &trans       &trans          &none         &kp EQUAL  &kp GT     &kp RBKT    &kp RBRC   &kp RPAR      &trans
&trans     &kp SQT    &kp DQT    &kp GRAVE  &kp BSLH   &kp MINUS                               &trans         &trans                                                 &kp PLUS   &kp COLON  &kp SEMI     &kp QUESTION &kp FSLH     &trans
&trans     &trans     &trans     &trans     &trans                 &trans      &trans        &trans           &trans       &trans          &trans                    &trans     &trans     &trans       &trans     &trans
            >;
        };

        util_layer {
            display-name = "Util";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6     &bootloader                                                                            &bootloader   &kp F7     &kp F8     &kp F9       &kp F10    &kp F11       &kp F12
&trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                        &none         &kp KP_NUM &kp KP_N7  &kp KP_N8    &kp KP_N9  &none        &none
&studio_unlock &sk LGUI &sk LALT   &sk LCTRL  &sk LSHFT  &bt BT_CLR &none      &trans        &trans           &trans       &trans          &none         &kp KP_N4  &kp KP_N5 &kp KP_N6 &none &none       &kp KP_ENTER
&trans     &kp PAUSE_BREAK &kp PRINTSCREEN &kp LC(LA(END)) &kp LC(LA(PAUSE_BREAK)) &trans                 &trans         &trans                                                 &kp KP_N1  &kp KP_N2 &kp KP_N3 &kp KP_DOT &kp KP_ENTER &trans
&bt BT_CLR_ALL &rgb_ug RGB_TOG &bl BL_DEC &bl BL_INC &trans          &trans      &trans        &trans           &trans       &trans          &trans                    &kp KP_N0  &kp KP_N0  &kp KP_DOT   &none     &trans
            >;
        };

        local_layer {
            display-name = "Local";
            bindings = <
&trans     &trans     &trans     &trans     &trans     &trans     &none                                                                                 &none         &trans     &trans     &trans       &trans     &trans         &trans
&trans     &trans     &trans     &trans     &trans     &trans     &none                                                                                 &none         &trans     &kp F17    &kp F18      &kp F19    &kp F20       &trans
&trans     &trans     &trans     &trans     &trans     &trans     &none      &trans        &trans           &trans       &trans          &none         &kp F13    &kp F14    &kp F15      &kp F16    &trans        &trans
&trans     &trans     &trans     &trans     &trans     &trans                                 &trans         &trans                                                 &kp F21    &kp F22    &kp F23      &kp F24    &trans        &trans
&trans     &trans     &trans     &trans     &trans                 &trans      &trans        &trans           &trans       &trans          &trans                    &trans     &trans     &trans       &trans     &trans
            >;
        };
    };
};
